<Window x:Class="WindowAgentMcp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Agent MCP 窗口选择器" Height="480" Width="700"
        MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="选择交由 AI Agent 操作的窗口" />
      <TextBlock Margin="0,6,0,0" Foreground="DimGray"
                 Text="Agent 只能截图和操作你在此处连接的窗口。" />
    </StackPanel>

    <ListBox Grid.Row="2" x:Name="WindowList" IsEnabled="True"
             DisplayMemberPath="DisplayName"
             SelectionChanged="WindowList_SelectionChanged" />

    <DockPanel Grid.Row="4" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="RefreshButton" MinWidth="90" Margin="8,0,0,0" Padding="12,6"
                Content="刷新" Click="RefreshButton_Click" />
        <Button x:Name="ConnectButton" MinWidth="90" Margin="8,0,0,0" Padding="12,6"
                Content="连接" IsEnabled="False" Click="ConnectButton_Click" />
        <Button x:Name="DisconnectButton" MinWidth="90" Margin="8,0,0,0" Padding="12,6"
                Content="断开" IsEnabled="False" Click="DisconnectButton_Click" />
      </StackPanel>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                 Text="尚未选择窗口" />
    </DockPanel>
  </Grid>
</Window>
